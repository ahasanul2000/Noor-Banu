// Noor Banu store — PostgreSQL schema.
// Field names stay snake_case on purpose: they match the JSON the storefront already reads
// (and the old Laravel tables), so API responses can be returned without renaming.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int        @id @default(autoincrement())
  name              String
  email             String?    @unique
  email_verified_at DateTime?  @db.Timestamptz(3)
  password          String
  is_admin          Boolean    @default(false)
  phone             String?    @unique
  address           String?
  city              String?
  shipping_area     String?
  created_at        DateTime   @default(now()) @db.Timestamptz(3)
  updated_at        DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  orders            Order[]
  tokens            ApiToken[]

  @@map("users")
}

/// Bearer tokens for storefront customers and session tokens for the admin panel.
/// Only a SHA-256 hash of the token is stored.
model ApiToken {
  id           Int       @id @default(autoincrement())
  user_id      Int
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name         String
  token        String    @unique
  last_used_at DateTime? @db.Timestamptz(3)
  expires_at   DateTime? @db.Timestamptz(3)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([user_id])
  @@map("api_tokens")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  icon        String?
  image       String?
  description String?
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  products    Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  category_id Int
  category    Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  name        String
  slug        String      @unique
  sku         String?
  description String?
  price       Decimal     @db.Decimal(10, 2)
  sale_price  Decimal?    @db.Decimal(10, 2)
  /// Used when the product has no size variants.
  stock       Int         @default(0)
  /// [{ size, stock }] — per-size inventory.
  variants    Json        @default("[]")
  /// [{ name }]
  colors      Json        @default("[]")
  badge       String?
  image       String?
  /// [url, url, ...]
  gallery     Json        @default("[]")
  /// [{ info }]
  details     Json        @default("[]")
  is_active   Boolean     @default(true)
  is_featured Boolean     @default(false)
  is_trending Boolean     @default(false)
  sort_order  Int         @default(0)
  created_at  DateTime    @default(now()) @db.Timestamptz(3)
  updated_at  DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  order_items OrderItem[]
  lookbooks   Lookbook[]

  @@index([category_id])
  @@map("products")
}

model Blog {
  id         Int      @id @default(autoincrement())
  title      String
  slug       String   @unique
  content    String?
  thumbnail  String?
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("blogs")
}

model SiteSetting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String?
  type       String   @default("text")
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

model Subscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("subscribers")
}

model Order {
  id               Int         @id @default(autoincrement())
  user_id          Int?
  user             User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  order_number     String?     @unique
  customer_name    String
  customer_email   String?
  customer_phone   String?
  shipping_address String?
  city             String?
  shipping_area    String?
  note             String?
  admin_note       String?
  subtotal         Decimal     @default(0) @db.Decimal(10, 2)
  discount         Decimal     @default(0) @db.Decimal(10, 2)
  shipping_cost    Decimal     @default(0) @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  coupon_code      String?
  payment_method   String      @default("cod")
  payment_status   String      @default("unpaid")
  status           String      @default("pending")
  /// Legacy line items from before order_items existed.
  items            Json?
  created_at       DateTime    @default(now()) @db.Timestamptz(3)
  updated_at       DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  order_items      OrderItem[]

  @@index([status])
  @@index([user_id])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  order_id      Int
  order         Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id    Int?
  product       Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name  String
  product_image String?
  size          String?
  color         String?
  unit_price    Decimal  @db.Decimal(10, 2)
  quantity      Int
  line_total    Decimal  @db.Decimal(10, 2)
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model Coupon {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  /// percent | fixed
  type             String    @default("percent")
  value            Decimal   @db.Decimal(10, 2)
  min_order_amount Decimal   @default(0) @db.Decimal(10, 2)
  max_discount     Decimal?  @db.Decimal(10, 2)
  usage_limit      Int?
  used_count       Int       @default(0)
  starts_at        DateTime? @db.Timestamptz(3)
  expires_at       DateTime? @db.Timestamptz(3)
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(3)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("coupons")
}

model HeroSlide {
  id          Int      @id @default(autoincrement())
  title       String
  highlight   String?
  subtitle    String?
  image       String
  button_text String?
  button_link String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("hero_slides")
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  name       String
  role       String?
  content    String
  image      String?
  rating     Int      @default(5)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("testimonials")
}

model Feature {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  icon        String   @default("gem")
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("features")
}

model Lookbook {
  id            Int      @id @default(autoincrement())
  title         String
  image         String
  product_id    Int?
  product       Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  category_name String?
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(3)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("lookbooks")
}

model InstagramPost {
  id         Int      @id @default(autoincrement())
  image      String
  link       String?
  caption    String?
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("instagram_posts")
}

/// Fixed-window request counters (works across serverless instances, unlike in-memory limits).
model RateLimit {
  key      String   @id
  count    Int
  reset_at DateTime @db.Timestamptz(3)

  @@map("rate_limits")
}
